<odoo>
    <record id="groups_privilege_distributor_schemes" model="res.groups.privilege">
        <field name="name">Distributor Schemes</field>
        <field name="category_id" ref="base.module_category_sales_sales"/>
        <field name="sequence">35</field>
    </record>
    <record id="group_scheme_operator" model="res.groups">
        <field name="name">Distributor Scheme Operator</field>
        <field name="privilege_id" ref="groups_privilege_distributor_schemes"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_scheme_manager" model="res.groups">
        <field name="name">Distributor Scheme Manager</field>
        <field name="privilege_id" ref="groups_privilege_distributor_schemes"/>
        <field name="implied_ids" eval="[(4, ref('group_scheme_operator'))]"/>
    </record>
    <record id="group_scheme_auditor" model="res.groups">
        <field name="name">Distributor Scheme Auditor</field>
        <field name="privilege_id" ref="groups_privilege_distributor_schemes"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
</odoo>
