<odoo>
    <record id="view_distributor_scheme_claim_decision_wizard_form" model="ir.ui.view">
        <field name="name">gt.distributor.scheme.claim.decision.wizard.form</field>
        <field name="model">gt.distributor.scheme.claim.decision.wizard</field>
        <field name="arch" type="xml">
            <form string="Settlement Claim Decision">
                <group>
                    <field name="claim_id"/>
                    <field name="distributor_id"/>
                    <field name="scheme_id"/>
                    <field name="period_id"/>
                    <field name="net_quantity"/>
                    <field name="qualifying_uom_id"/>
                    <field name="reward_product_id"/>
                    <field name="reward_quantity"/>
                    <field name="source_validation_status"/>
                    <field name="decision"/>
                    <field name="reason" placeholder="Explain the decision or revision request"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm Decision" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
