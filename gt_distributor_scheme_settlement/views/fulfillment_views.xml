<odoo>
    <record id="view_scheme_fulfillment_wizard_form" model="ir.ui.view">
        <field name="name">gt.distributor.scheme.fulfillment.wizard.form</field>
        <field name="model">gt.distributor.scheme.fulfillment.wizard</field>
        <field name="arch" type="xml">
            <form string="Prepare Free Goods Fulfillment">
                <group>
                    <field name="claim_id"/>
                    <field name="company_id"/>
                    <field name="warehouse_id" domain="[('company_id', '=', company_id)]" options="{'no_create': True}"/>
                </group>
                <div class="alert alert-info" role="alert">
                    The system creates one zero-priced reward order using the frozen approved product, unit and quantity.
                    Standard warehouse reservation and delivery steps still apply.
                </div>
                <footer>
                    <button name="action_prepare" type="object" string="Create and Confirm Order" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_scheme_adjustment_review_wizard_form" model="ir.ui.view">
        <field name="name">gt.distributor.scheme.adjustment.review.wizard.form</field>
        <field name="model">gt.distributor.scheme.adjustment.review.wizard</field>
        <field name="arch" type="xml">
            <form string="Review Settlement Adjustment">
                <group>
                    <field name="adjustment_id"/>
                    <field name="review_note" placeholder="Record the evidence reviewed and next action." required="1"/>
                </group>
                <div class="alert alert-warning" role="alert">
                    Recording review does not authorize extra goods, change the approved quantity, return stock, or post a financial recovery.
                </div>
                <footer>
                    <button name="action_confirm_review" type="object" string="Record Review" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
