<odoo>
    <record id="view_distributor_scheme_audit_list" model="ir.ui.view">
        <field name="name">gt.distributor.scheme.audit.list</field>
        <field name="model">gt.distributor.scheme.audit</field>
        <field name="arch" type="xml">
            <list string="Claim Audit History" create="0" edit="0" delete="0" default_order="event_date desc, id desc">
                <field name="event_date"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="scheme_id"/>
                <field name="claim_id"/>
                <field name="event_type"/>
                <field name="actor_id"/>
            </list>
        </field>
    </record>
    <record id="view_distributor_scheme_audit_search" model="ir.ui.view">
        <field name="name">gt.distributor.scheme.audit.search</field>
        <field name="model">gt.distributor.scheme.audit</field>
        <field name="arch" type="xml">
            <search string="Claim Audit History">
                <field name="claim_id"/>
                <field name="scheme_id"/>
                <field name="event_type"/>
                <field name="actor_id"/>
                <group>
                    <filter name="group_claim" string="Claim" context="{'group_by': 'claim_id'}"/>
                    <filter name="group_type" string="Event Type" context="{'group_by': 'event_type'}"/>
                    <filter name="group_actor" string="Actor" context="{'group_by': 'actor_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_distributor_scheme_audit" model="ir.actions.act_window">
        <field name="name">Claim Audit History</field>
        <field name="res_model">gt.distributor.scheme.audit</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_distributor_scheme_audit_search"/>
    </record>
</odoo>
