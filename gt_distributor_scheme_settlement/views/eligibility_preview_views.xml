<odoo>
    <record id="view_scheme_preview_wizard_form" model="ir.ui.view">
        <field name="name">gt.distributor.scheme.preview.wizard.form</field>
        <field name="model">gt.distributor.scheme.preview.wizard</field>
        <field name="arch" type="xml">
            <form string="Purchase Eligibility Preview">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Read-only, non-binding preview. It does not create claims, sales orders, stock transfers, or accounting entries.
                    </div>
                    <group>
                        <group>
                            <field name="scheme_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="distributor_id" domain="[('id', 'in', scheme_distributor_ids)]"/>
                            <field name="scheme_distributor_ids" invisible="True"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="as_of" help="Records changed after this cutoff block historical reconstruction."/>
                        </group>
                    </group>
                    <group string="Preview Result" invisible="not calculation_status">
                        <group>
                            <field name="calculation_status" widget="badge"/>
                            <field name="gross_quantity"/>
                            <field name="refund_quantity"/>
                            <field name="net_quantity"/>
                            <field name="qualifying_uom_id"/>
                        </group>
                        <group>
                            <field name="slab_id"/>
                            <field name="reward_product_id"/>
                            <field name="reward_quantity"/>
                            <field name="invoice_count"/>
                            <field name="refund_count"/>
                        </group>
                        <field name="source_fingerprint" readonly="1"/>
                    </group>
                    <notebook invisible="not calculation_status">
                        <page string="Exceptions"><field name="exception_summary" nolabel="1" readonly="1"/></page>
                        <page string="Accounting Sources"><field name="source_evidence" nolabel="1" readonly="1" widget="text"/></page>
                    </notebook>
                </sheet>
                <footer>
                    <button name="action_calculate" type="object" string="Calculate Preview" class="oe_highlight"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
