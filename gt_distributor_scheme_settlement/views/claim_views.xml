<odoo>
    <record id="view_distributor_scheme_claim_list" model="ir.ui.view"><field name="name">gt.distributor.scheme.claim.list</field><field name="model">gt.distributor.scheme.claim</field><field name="arch" type="xml"><list string="Settlement Claims"><field name="name"/><field name="scheme_id"/><field name="distributor_id"/><field name="period_id"/><field name="company_id" groups="base.group_multi_company"/><field name="entitlement_quantity"/><field name="state" widget="badge"/></list></field></record>
    <record id="view_distributor_scheme_claim_form" model="ir.ui.view"><field name="name">gt.distributor.scheme.claim.form</field><field name="model">gt.distributor.scheme.claim</field><field name="arch" type="xml"><form string="Settlement Claim"><sheet><div class="oe_title"><h1><field name="name"/></h1></div><group><group><field name="scheme_id"/><field name="distributor_id"/><field name="period_id"/></group><group><field name="company_id" groups="base.group_multi_company"/><field name="entitlement_quantity"/><field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,fulfilled,cancelled" readonly="1"/></group></group><group string="Approval"><field name="approved_by_id"/><field name="approved_at"/></group><group string="Fulfillment"><field name="fulfillment_order_id"/><field name="fulfillment_picking_ids" widget="many2many_tags"/></group><notebook><page string="Source Evidence"><field name="source_ids" readonly="1"><list><field name="invoice_date"/><field name="move_id"/><field name="product_id"/><field name="quantity"/><field name="unit_price"/></list></field></page><page string="Adjustments"><field name="adjustment_ids" readonly="1"><list><field name="adjustment_date"/><field name="quantity_delta"/><field name="source_move_id"/><field name="created_by_id"/></list></field></page><page string="Notes"><field name="note"/></page></notebook><p class="text-muted">Approval, purchase calculation, and fulfillment workflows are not implemented in this release.</p></sheet><chatter/></form></field></record>
    <record id="view_distributor_scheme_claim_search" model="ir.ui.view"><field name="name">gt.distributor.scheme.claim.search</field><field name="model">gt.distributor.scheme.claim</field><field name="arch" type="xml"><search string="Search Claims"><field name="name"/><field name="scheme_id"/><field name="distributor_id"/><filter name="draft" string="Draft" domain="[('state','=','draft')]"/><filter name="approved" string="Approved" domain="[('state','=','approved')]"/><group><filter name="group_scheme" string="Scheme" context="{'group_by':'scheme_id'}"/><filter name="group_state" string="State" context="{'group_by':'state'}"/></group></search></field></record>
    <record id="action_distributor_scheme_claims" model="ir.actions.act_window"><field name="name">Settlement Claims</field><field name="res_model">gt.distributor.scheme.claim</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_distributor_scheme_claim_search"/></record>
</odoo>
