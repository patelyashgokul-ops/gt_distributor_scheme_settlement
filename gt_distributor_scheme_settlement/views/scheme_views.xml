<odoo>
    <record id="view_distributor_scheme_list" model="ir.ui.view">
        <field name="name">gt.distributor.scheme.list</field>
        <field name="model">gt.distributor.scheme</field>
        <field name="arch" type="xml">
            <list string="Distributor Schemes">
                <field name="name"/>
                <field name="code"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="qualifying_product_id"/>
                <field name="reward_product_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="view_distributor_scheme_form" model="ir.ui.view">
        <field name="name">gt.distributor.scheme.form</field>
        <field name="model">gt.distributor.scheme</field>
        <field name="arch" type="xml">
            <form string="Distributor Scheme">
                <sheet>
                    <div class="oe_title"><label for="name"/><h1><field name="name" placeholder="e.g. Summer Distributor Offer"/></h1></div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="state" widget="statusbar" statusbar_visible="draft,active,closed,cancelled" readonly="1"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="distributor_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <group string="Products and Qualification">
                        <field name="qualifying_product_id"/>
                        <field name="qualifying_uom_id"/>
                        <field name="reward_product_id"/>
                    </group>
                    <notebook>
                        <page string="Purchase Slabs"><field name="slab_ids" readonly="1"><list><field name="minimum_quantity"/><field name="maximum_quantity"/><field name="reward_quantity"/></list></field></page>
                        <page string="Calculation Periods"><field name="period_ids" readonly="1"><list><field name="name"/><field name="date_start"/><field name="date_end"/><field name="state"/></list></field></page>
                        <page string="Notes"><field name="notes" placeholder="Internal scheme notes"/></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_distributor_scheme_search" model="ir.ui.view">
        <field name="name">gt.distributor.scheme.search</field>
        <field name="model">gt.distributor.scheme</field>
        <field name="arch" type="xml">
            <search string="Search Schemes">
                <field name="name"/><field name="code"/><field name="qualifying_product_id"/><field name="distributor_ids"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="active" string="Active" domain="[('state','=','active')]"/>
                <group><filter name="group_state" string="State" context="{'group_by':'state'}"/><filter name="group_company" string="Company" context="{'group_by':'company_id'}"/></group>
            </search>
        </field>
    </record>
    <record id="action_distributor_schemes" model="ir.actions.act_window">
        <field name="name">Schemes</field><field name="res_model">gt.distributor.scheme</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_distributor_scheme_search"/>
    </record>
</odoo>
